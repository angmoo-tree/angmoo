{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Angmoo Native Runtime Spike",
  "version": "0.0.0",
  "identifier": "com.angmoo.spike.native-runtime",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Angmoo Native Runtime Spike",
        "width": 480,
        "height": 780,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../../../frontend/public/favicon.ico"],
    "externalBin": ["binaries/angmoo-spike-sidecar"]
  }
}
