{
  "name": "angmoo-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "tauri": "tauri",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-sidecar.ps1",
    "dev": "npm run build:sidecar && tauri dev",
    "dev:docker-bridge": "tauri dev --config src-tauri/tauri.contributor-docker.conf.json --features contributor-docker-bridge",
    "build:shell": "tauri build --no-bundle",
    "build:product": "npm run build:sidecar && npm run build:shell",
    "build:installer-payload": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-installer-payload.ps1",
    "build:installer": "npm run build:sidecar && tauri build --bundles nsis"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
