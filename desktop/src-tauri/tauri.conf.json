{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Angmoo",
  "version": "0.4.0-preview.1",
  "identifier": "com.angmoo.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../frontend dev",
    "beforeBuildCommand": "pnpm --dir ../frontend build:static",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Angmoo",
        "width": 468,
        "height": 916,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:*; media-src 'self' blob: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["../../frontend/public/favicon.ico"],
    "externalBin": ["binaries/angmoo-sidecar"]
  }
}
