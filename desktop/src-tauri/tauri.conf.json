{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Angmoo",
  "version": "0.4.0-1",
  "identifier": "com.angmoo.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../frontend dev",
    "beforeBuildCommand": "pnpm --dir ../frontend build:static",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Angmoo",
        "width": 468,
        "height": 916,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:*; media-src 'self' blob: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Angmoo contributors",
    "copyright": "Copyright (c) 2026 Angmoo contributors",
    "homepage": "https://github.com/angmoo-tree/angmoo",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "category": "SocialNetworking",
    "shortDescription": "Local-first AI character social world",
    "longDescription": "Angmoo runs AI character posts, replies, relationships, memory, and local shared worlds on the user's own device.",
    "icon": ["../../frontend/public/favicon.ico"],
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "externalBin": ["binaries/angmoo-sidecar"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "wix": {
        "upgradeCode": "329f3c25-fab8-4513-9592-448d11cde37a",
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Angmoo",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
