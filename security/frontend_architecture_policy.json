{
  "documentation": "docs/architecture/frontend-product-shell.md",
  "feature_names": [
    "creator-studio",
    "device-home",
    "pwa-shell",
    "runtime-status",
    "world-app",
    "world-packages"
  ],
  "legacy_import_exceptions": [],
  "legacy_import_prefixes": [
    "@/components",
    "@/lib"
  ],
  "policy_id": "angmoo-l2-5-frontend-product-shell-v1",
  "required_markers": {
    "frontend/public/sw.js": [
      "ANGMOO_WORKER_VERSION",
      "addEventListener(\"activate\"",
      "addEventListener(\"install\""
    ],
    "frontend/src/app/manifest.ts": [
      "display: \"standalone\"",
      "scope: \"/\"",
      "start_url: \"/\""
    ],
    "frontend/src/features/creator-studio/ui/creator-studio-dashboard.tsx": [
      "getLocalWorldSurface(\"creator_studio\"",
      "studioWorldRoute(world.world_id)",
      "worldAppRoute(world.world_id)"
    ],
    "frontend/src/features/device-home/model/device-home-contract.ts": [
      "bezelWidthPx: 3",
      "cornerRadiusPx: 34",
      "frameStyle: \"thin-uniform-flat\"",
      "iconStyle: \"squircle-grid\"",
      "maxWidthPx: 436"
    ],
    "frontend/src/features/device-home/public.ts": [
      "DEVICE_HOME_FIXED_APPS",
      "DeviceHomeShell"
    ],
    "frontend/src/features/pwa-shell/ui/pwa-service-worker-lifecycle.tsx": [
      "registration.unregister()",
      "registration.update()",
      "updateViaCache: \"none\""
    ],
    "frontend/src/features/world-app/model/world-app-contract.ts": [
      "availability: \"unavailable\"",
      "id: \"relationships\"",
      "segment: \"feed\"",
      "worldAppSectionRoute"
    ],
    "frontend/src/shared/ui/device-frame.module.css": [
      "--device-bezel-width: 3px",
      "--device-corner-radius: 34px"
    ]
  },
  "required_paths": [
    "frontend/public/sw.js",
    "frontend/src/app/manifest.ts",
    "frontend/src/features/creator-studio/public.ts",
    "frontend/src/features/creator-studio/ui/creator-studio-dashboard.tsx",
    "frontend/src/features/creator-studio/ui/creator-studio-frame.tsx",
    "frontend/src/features/device-home/public.ts",
    "frontend/src/features/pwa-shell/public.ts",
    "frontend/src/features/pwa-shell/ui/pwa-service-worker-lifecycle.tsx",
    "frontend/src/features/runtime-status/public.ts",
    "frontend/src/features/world-app/api/world-app-client.ts",
    "frontend/src/features/world-app/model/world-app-contract.ts",
    "frontend/src/features/world-app/public.ts",
    "frontend/src/features/world-app/ui/world-app.tsx",
    "frontend/src/features/world-packages/public.ts",
    "frontend/src/shared/navigation/public.ts",
    "frontend/src/shared/ui/app-icon.tsx",
    "frontend/src/shared/ui/device-frame.tsx",
    "frontend/src/shared/ui/public.ts",
    "frontend/src/shared/ui/status-badge.tsx"
  ],
  "schema_version": 1
}
