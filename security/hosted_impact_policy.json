{
  "schema_version": 1,
  "severity_order": [
    "public-only",
    "hosted-fast",
    "hosted-full"
  ],
  "rules": [
    {
      "classification": "hosted-full",
      "exact": [
        ".github/dependabot.yml",
        ".gitattributes",
        ".gitleaks.toml",
        "backend/app/api/v1/deps.py",
        "backend/app/api/v1/routes/agent_runs.py",
        "backend/app/api/v1/routes/agents.py",
        "backend/app/api/v1/routes/auth.py",
        "backend/app/api/v1/routes/bot.py",
        "backend/app/api/v1/routes/character_lore.py",
        "backend/app/core/config.py",
        "backend/app/core/redaction.py",
        "backend/app/core/startup_security.py",
        "backend/app/schemas/__init__.py",
        "backend/app/schemas/admin.py",
        "backend/app/services/auth.py",
        "backend/app/services/character_lore.py",
        "backend/app/services/community_abuse_quota.py",
        "backend/app/services/external_auth_verification.py",
        "backend/app/services/hosted_configuration.py",
        "backend/app/services/image_provider.py",
        "backend/app/services/image_prompt_safety.py",
        "backend/app/services/langgraph_resident.py",
        "backend/app/services/lore_parser_quota.py",
        "backend/app/services/local_bot_quota.py",
        "backend/app/services/post_image_job_worker.py",
        "backend/app/services/prompt_safety.py",
        "backend/app/services/resident_contracts.py",
        "backend/app/services/resident_tick_scheduler.py",
        "backend/app/services/service_image_key.py",
        "backend/tests/test_demo_account_lock.py",
        "backend/pyproject.toml",
        "backend/uv.lock",
        "compose.yml",
        "frontend/next.config.ts",
        "frontend/package.json",
        "frontend/pnpm-lock.yaml",
        "frontend/src/app/admin/page.tsx",
        "frontend/src/app/demo/kimarin/page.tsx",
        "frontend/src/app/portfolio-review/page.tsx",
        "frontend/src/components/admin-dashboard-client.tsx",
        "frontend/src/components/demo-kimarin-client.tsx",
        "frontend/src/components/portfolio-review-client.tsx",
        "frontend/src/lib/admin.ts",
        "frontend/src/lib/agents.ts",
        "frontend/src/lib/portfolio-review.ts",
        "backend/app/api/v1/routes/world_activity_runtime.py",
        "backend/app/cruds/graph_projection.py",
        "backend/app/integrations/neo4j.py",
        "backend/app/repositories/relationship_graph.py",
        "backend/app/schemas/relationship_graph.py",
        "backend/app/services/graph_projection_commands.py",
        "backend/app/services/graph_projection_metrics.py",
        "backend/app/services/graph_projection_replay.py",
        "backend/app/services/graph_projection_runtime.py",
        "backend/app/services/graph_projection_worker.py",
        "backend/app/services/relationship_graph_read.py",
        "backend/app/services/social_memory_read.py",
        "backend/scripts/replay_relationship_graph.py",
        "backend/scripts/run_graph_projection_worker.py",
        "compose.neo4j.yml"
      ],
      "prefixes": [
        ".github/workflows/",
        "backend/angmoo_hosted/",
        "backend/app/alembic/",
        "backend/app/credentials/",
        "backend/app/models/",
        "backend/app/providers/",
        "backend/security/",
        "scripts/",
        "security/"
      ]
    },
    {
      "classification": "hosted-fast",
      "exact": [
        "CONTRIBUTING.ko.md",
        "CONTRIBUTING.md",
        "README.ko.md",
        "README.md",
        "SECURITY.md"
      ],
      "prefixes": [
        "backend/",
        "docs/public/",
        "frontend/"
      ]
    },
    {
      "classification": "public-only",
      "exact": [
        ".github/PULL_REQUEST_TEMPLATE.md",
        ".gitignore",
        "BRANDING.md",
        "CODE_OF_CONDUCT.md",
        "LICENSE",
        "NOTICE",
        "THIRD_PARTY_NOTICES.md"
      ],
      "prefixes": [
        ".github/ISSUE_TEMPLATE/"
      ]
    }
  ]
}
