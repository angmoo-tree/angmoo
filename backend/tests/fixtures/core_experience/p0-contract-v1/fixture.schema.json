{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://angmoo.example/contracts/p0-contract-v1/fixture.schema.json",
  "title": "Angmoo core experience contract fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "contract_version",
    "required_phase",
    "input",
    "expected",
    "variants"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "contract_version": {
      "const": "p0-contract-v1"
    },
    "required_phase": {
      "type": "string",
      "pattern": "^P([1-9]|1[01])$"
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "code",
        "writes",
        "provider_call_count",
        "notes"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "success",
            "rejected",
            "deferred",
            "fallback"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "provider_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    }
  }
}
