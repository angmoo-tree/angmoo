{
  "$defs": {
    "JsonValue": {},
    "PortableWorldCharacterSeed": {
      "additionalProperties": false,
      "properties": {
        "access_scope": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Access Scope",
          "type": "array"
        },
        "background": {
          "default": "",
          "maxLength": 3000,
          "title": "Background",
          "type": "string"
        },
        "character_ref": {
          "pattern": "^characters/[a-z][a-z0-9-]{0,63}$",
          "title": "Character Ref",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 32,
          "title": "Extensions",
          "type": "object"
        },
        "role_description": {
          "default": "",
          "maxLength": 1000,
          "title": "Role Description",
          "type": "string"
        },
        "role_ref": {
          "pattern": "^roles/[a-z][a-z0-9-]{0,63}$",
          "title": "Role Ref",
          "type": "string"
        }
      },
      "required": [
        "character_ref",
        "role_ref"
      ],
      "title": "PortableWorldCharacterSeed",
      "type": "object"
    }
  },
  "$id": "https://angmoo.dev/schemas/world-package/v1/world-characters.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "characters": {
      "items": {
        "$ref": "#/$defs/PortableWorldCharacterSeed"
      },
      "maxItems": 50,
      "title": "Characters",
      "type": "array"
    },
    "schema_version": {
      "const": "world-characters-content-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "world_ref": {
      "const": "world",
      "title": "World Ref",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "world_ref",
    "characters"
  ],
  "title": "WorldCharactersDocument",
  "type": "object"
}
