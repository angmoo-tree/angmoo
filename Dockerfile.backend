# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.13-slim@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a
FROM ${PYTHON_IMAGE} AS base

ARG UV_VERSION=0.12.5
ARG VCS_REF=unknown
ARG VERSION=0.1.0

LABEL org.opencontainers.image.source="https://github.com/angmoo-tree/angmoo" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="GPL-3.0-only"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

RUN groupadd --gid 10001 angmoo \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin angmoo \
    && python -m pip install --no-cache-dir "uv==${UV_VERSION}" \
    && mkdir -p /var/lib/angmoo/media \
    && chown -R angmoo:angmoo /var/lib/angmoo

COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
RUN uv sync --frozen --no-dev --no-install-project --no-cache

FROM base AS source
COPY --chown=angmoo:angmoo backend/app ./app
COPY --chown=angmoo:angmoo backend/scripts ./scripts
COPY --chown=angmoo:angmoo backend/alembic.ini ./
COPY --chown=angmoo:angmoo scripts/docker/backend-entrypoint.sh /usr/local/bin/angmoo-backend-entrypoint
RUN chmod 0555 /usr/local/bin/angmoo-backend-entrypoint

FROM base AS development
WORKDIR /workspace/backend
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY --chown=angmoo:angmoo . /workspace
COPY --chown=angmoo:angmoo --chmod=0555 scripts/docker/backend-entrypoint.sh /usr/local/bin/angmoo-backend-entrypoint
RUN uv sync --frozen --no-install-project
ENV PATH="/workspace/backend/.venv/bin:${PATH}"
USER angmoo
ENTRYPOINT ["/usr/local/bin/angmoo-backend-entrypoint"]
CMD ["api-dev"]

FROM source AS runtime
RUN rm -rf \
      /root/.cache \
      /usr/local/bin/pip* \
      /usr/local/bin/uv \
      /usr/local/bin/uvx \
      /usr/local/lib/python3.13/site-packages/pip \
      /usr/local/lib/python3.13/site-packages/pip-*.dist-info \
      /usr/local/lib/python3.13/site-packages/uv \
      /usr/local/lib/python3.13/site-packages/uv-*.dist-info
USER angmoo
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"
ENTRYPOINT ["/usr/local/bin/angmoo-backend-entrypoint"]
CMD ["api"]
